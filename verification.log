def SetCover.DensityCertificate : {v M : ℕ} → ℕ → SetCover.CheapMatrix v M → Prop :=
fun {v M} k A =>
  ∀ (f g : SetCover.Cube v → ℝ),
    SetCover.IsDensity f →
      SetCover.IsDensity g →
        1 - (SetCover.lambda k M + Real.exp (-↑(SetCover.effectiveDimension k v) / 120)) -
            120 / ↑(SetCover.effectiveDimension k v) * (SetCover.entropy f + SetCover.entropy g) ≤
          SetCover.pairing (SetCover.noiseMass k A) f g
